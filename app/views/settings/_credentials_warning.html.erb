<div id="credentials-unreadable-warning" role="alert" class="mb-6 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 text-sm text-amber-100">
  <p class="font-semibold text-amber-200"><%= t("ui.settings.credentials_unreadable.header") %></p>
  <ul class="mt-2 list-disc space-y-1 pl-5">
    <% if apple_unreadable %>
      <li><%= t("ui.settings.credentials_unreadable.apple") %></li>
    <% end %>
    <% if sources.any? %>
      <li><%= t("ui.settings.credentials_unreadable.sources", names: sources.map(&:name).to_sentence) %></li>
    <% end %>
  </ul>
  <p class="mt-3 text-amber-200/90"><%= t("ui.settings.credentials_unreadable.recovery_html", path: tag.code(CalendarHub::CredentialEncryption.key_location)) %></p>
</div>
