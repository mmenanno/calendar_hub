<% if turbo_frame_request? %>
  <turbo-frame id="modal">
    <div class="modal-card">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= t("ui.mappings.edit_mapping") %></h2>
        <button type="button" data-action="modal#close" class="cursor-pointer rounded-md border border-slate-700 px-2 py-1 text-xs text-slate-300 hover:border-slate-500"><%= t("ui.mappings.close") %></button>
      </div>
      <%= render "event_mappings/form", mapping: @mapping %>
    </div>
  </turbo-frame>
<% else %>
  <% content_for :title, t("ui.mappings.edit_mapping") %>
  <%= render "shared/page_header",
        nav_active: :mappings,
        max_width: "max-w-3xl",
        icon: content_tag(:svg, content_tag(:path, "", "stroke-linecap": "round", "stroke-linejoin": "round", "stroke-width": "1.5", d: "M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"), xmlns: "http://www.w3.org/2000/svg", class: "h-6 w-6", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor"),
        title: t("ui.mappings.edit_mapping"),
        subtitle: t("ui.mappings.subheader") do %>
    <%= render "shared/breadcrumb", breadcrumbs: [[t("ui.mappings.header"), event_mappings_path], [t("ui.mappings.edit_mapping")]] %>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <%= render "event_mappings/form", mapping: @mapping %>
    </div>
  <% end %>
<% end %>
