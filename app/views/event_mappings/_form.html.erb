<%# Shared create/edit form for event mappings. Locals: mapping %>
<% label_class = "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-slate-400" %>
<%= form_with model: mapping, url: mapping.persisted? ? event_mapping_path(mapping) : event_mappings_path, method: mapping.persisted? ? :patch : :post, namespace: (dom_id(mapping) if mapping.persisted?), class: "grid gap-3 #{"md:grid-cols-2" if mapping.persisted?}", data: { controller: "mapping-form" } do |f| %>
  <% if mapping.errors.any? %>
    <div class="md:col-span-2">
      <%= render "shared/form_errors", record: mapping %>
    </div>
  <% end %>
  <div>
    <%= f.label(:calendar_source_id, t("ui.mappings.source"), class: label_class) %>
    <div class="select-chevron">
      <%= f.collection_select(:calendar_source_id, CalendarSource.order(:name), :id, :name, { include_blank: t("common.states.all") }, class: select_class) %>
    </div>
    <%= form_field_error(mapping, :calendar_source) %>
  </div>
  <div>
    <%= f.label(:match_type, t("ui.mappings.match"), class: label_class) %>
    <div class="select-chevron wide-select">
      <%= f.select(:match_type, EventMapping::MATCH_TYPES.values.map { |t| [t.humanize, t] }, {}, class: select_class, data: { mapping_form_target: "match", action: "change->mapping-form#validate" }) %>
    </div>
    <%= form_field_error(mapping, :match_type) %>
  </div>
  <div class="md:col-span-2">
    <%= f.label(:pattern, class: label_class) %>
    <%= f.text_field(:pattern, required: true, placeholder: "e.g. In-Person Counselling", class: input_class, data: { mapping_form_target: "pattern", action: "input->mapping-form#validate" }) %>
    <p data-mapping-form-target="error" class="mt-1 hidden text-xs text-rose-300"><%= t("ui.mappings.invalid_regex") %></p>
    <%= form_field_error(mapping, :pattern) %>
  </div>
  <div class="md:col-span-2">
    <%= f.label(:replacement, class: label_class) %>
    <%= f.text_field(:replacement, placeholder: "Client Session - In Person", class: input_class) %>
    <%= form_field_error(mapping, :replacement) %>
  </div>
  <div class="md:col-span-2" data-controller="browse-calendars" data-browse-calendars-url-value="<%= discover_apple_calendars_path %>">
    <%= f.label(:target_calendar_identifier, t("ui.mappings.destination"), class: label_class) %>
    <div class="flex items-center gap-2">
      <%= f.text_field(:target_calendar_identifier, placeholder: t("ui.mappings.destination_hint"), class: "#{input_class} flex-1", data: { browse_calendars_target: "calendarField" }) %>
      <button type="button" class="<%= secondary_button_class %> whitespace-nowrap text-xs" data-action="click->browse-calendars#browse"><%= t("ui.sources.browse_calendars") %></button>
    </div>
    <p class="mt-1 text-xs text-slate-400"><%= t("ui.mappings.destination_hint") %></p>
    <p data-browse-calendars-target="loading" class="mt-1 text-xs text-indigo-300 hidden"><%= t("ui.sources.browse_loading") %></p>
    <p data-browse-calendars-target="error" class="mt-1 text-xs text-rose-300 hidden"></p>
    <div data-browse-calendars-target="results" class="mt-2 hidden"></div>
    <%= form_field_error(mapping, :target_calendar_identifier) %>
  </div>
  <div class="md:col-span-2">
    <%= f.label(:target_calendar_display_name, t("ui.mappings.destination_display_name"), class: label_class) %>
    <%= f.text_field(:target_calendar_display_name, placeholder: "e.g. Work Calendar", class: input_class) %>
  </div>
  <div class="flex flex-wrap items-center gap-4 md:col-span-2">
    <label class="inline-flex items-center gap-2 text-xs text-slate-400">
      <%= f.check_box(:case_sensitive) %>
      <%= t("ui.mappings.case") %> sensitive
    </label>
    <% if mapping.persisted? %>
      <label class="inline-flex items-center gap-2 text-xs text-slate-400">
        <%= f.check_box(:active) %>
        <%= t("ui.mappings.active") %>
      </label>
      <div class="ml-auto flex gap-2">
        <%= f.submit(t("common.actions.save"), class: small_primary_button_class, data: { mapping_form_target: "submit" }) %>
        <% if turbo_frame_request? %>
          <button type="button" data-action="modal#close" class="cursor-pointer rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-200 hover:border-slate-500"><%= t("common.actions.cancel") %></button>
        <% else %>
          <%= link_to t("common.actions.cancel"), event_mappings_path, class: "cursor-pointer rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-200 hover:border-slate-500" %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% unless mapping.persisted? %>
    <%= f.submit(t("ui.mappings.add_mapping"), class: primary_button_class, data: { mapping_form_target: "submit" }) %>
  <% end %>
<% end %>
