<% variant = local_assigns[:variant] || :success %>
<% error = variant.to_sym == :error %>
<% badge_bg, badge_text, bar = if error
     ["bg-rose-500/20", "text-rose-300", "bg-rose-400/60"]
   else
     ["bg-emerald-500/20", "text-emerald-300", "bg-emerald-400/60"]
   end %>
<div class="pointer-events-auto max-w-sm rounded-lg border px-3 py-2 text-sm shadow-lg backdrop-blur"
     data-controller="dismissable" data-dismissable-delay-value="<%= error ? 8000 : 2500 %>"
     style="background: rgba(15,23,42,.9); border-color: rgba(51,65,85,.7)">
  <div class="flex items-start gap-2">
    <span class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full <%= badge_bg %> <%= badge_text %>" aria-hidden="true"><%= error ? "!" : "✓" %></span>
    <span class="min-w-0 flex-1 break-words text-slate-200"><% if error %><span class="sr-only"><%= t("common.states.error") %>: </span><% end %><%= message %></span>
    <button type="button" class="-mr-1 shrink-0 cursor-pointer rounded px-1 leading-none text-slate-400 transition hover:text-slate-200" data-action="dismissable#dismiss" aria-label="<%= t("common.actions.dismiss_notification") %>">&times;</button>
  </div>
  <div class="pointer-events-none mt-1 h-0.5 w-full bg-transparent">
    <div class="h-full w-0 <%= bar %>" data-dismissable-target="progress"></div>
  </div>
</div>
