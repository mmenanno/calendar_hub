<% if turbo_frame_request? %>
  <turbo-frame id="modal">
    <div class="modal-card">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= t("common.actions.edit") %> <%= @calendar_source.name %></h2>
        <button type="button" data-action="modal#close" class="cursor-pointer rounded-md border border-slate-700 px-2 py-1 text-xs text-slate-300 hover:border-slate-500"><%= t("common.actions.close") %></button>
      </div>
      <%= render "form", calendar_source: @calendar_source %>
    </div>
  </turbo-frame>
<% else %>
  <% content_for :title, "#{t("common.actions.edit")} #{@calendar_source.name}" %>
  <%= render "shared/page_header",
        nav_active: :sources,
        max_width: "max-w-3xl",
        icon: sources_icon,
        title: "#{t("common.actions.edit")} #{@calendar_source.name}",
        subtitle: t("ui.sources.edit_subheader") do %>
    <%= render "shared/breadcrumb", breadcrumbs: [[t("navigation.sources"), calendar_sources_path], [@calendar_source.name, calendar_source_path(@calendar_source)], [t("common.actions.edit")]] %>
    <%= render "form", calendar_source: @calendar_source %>
  <% end %>
<% end %>
