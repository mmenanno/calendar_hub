<% if turbo_frame_request? %>
  <turbo-frame id="modal">
    <div class="modal-card">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold"><%= t("ui.filter_rules.edit_rule") %></h2>
        <button type="button" data-action="modal#close" class="cursor-pointer rounded-md border border-slate-700 px-2 py-1 text-xs text-slate-300 hover:border-slate-500"><%= t("common.actions.close") %></button>
      </div>
      <%= render "filter_rules/form", filter_rule: @filter_rule %>
    </div>
  </turbo-frame>
<% else %>
  <% content_for :title, t("ui.filter_rules.edit_rule") %>
  <%= render "shared/page_header",
        nav_active: :filter_rules,
        icon: content_tag(:svg, content_tag(:path, "", "stroke-linecap": "round", "stroke-linejoin": "round", "stroke-width": "1.5", d: "M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z"), xmlns: "http://www.w3.org/2000/svg", class: "h-6 w-6", fill: "none", viewBox: "0 0 24 24", stroke: "currentColor"),
        title: t("ui.filter_rules.edit_rule"),
        subtitle: t("ui.filter_rules.subheader") do %>
    <%= render "shared/breadcrumb", breadcrumbs: [[t("ui.filter_rules.header"), filter_rules_path], [t("ui.filter_rules.edit_rule")]] %>
    <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5">
      <%= render "filter_rules/form", filter_rule: @filter_rule %>
    </div>
  <% end %>
<% end %>
